   "source": [
    "# ── Cell 3: load model ────────────────────────────────────────────────\n",
    "model_path = \"../models/llm/tinyllama\"\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_path)\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    model_path,\n",
    "    dtype=dtype,       # ← was wrongly written as dtype= before\n",
    "    device_map=\"auto\"        # auto picks cuda > mps > cpu\n",
    ")\n",
    "\n",
    "print(f\"Model loaded on : {device}\")\n",
    "print(f\"Memory used     : {psutil.virtual_memory().used / 1e9:.1f} GB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "387043d0-39c4-4c1c-b9e9-a4d2f6d9b098",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "── Response ──────────────────────────────\n",
      "A neural network is a mathematical model that simulates the functioning of the human brain and can be used to perform complex computational tasks such as classification, prediction, and decision-making. It consists of various layers or units called neurons, which process inputs and generate outputs based on preceding inputs. The input layer, hidden layer, and output layer define the functioning of a neural network, while the neuron architecture determines the processing steps required for the model to make predictions or classify data. A neural network can be trained using algorithms like backpropagation, which iteratively adjusts the weights of its neurons based on the gradients of its cost function.\n"
     ]
    }
   ],
   "source": [
    "# ── Cell 4: run a prompt ──────────────────────────────────────────────\n",
    "messages = [\n",
    "    {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"},\n",
    "    {\"role\": \"user\",   \"content\": \"Explain what a neural network is in 2 sentences.\"}\n",
    "]\n",
    "\n",
    "input_ids = tokenizer.apply_chat_template(\n",
    "    messages,\n",
    "    return_tensors=\"pt\",\n",
    "    add_generation_prompt=True   # tells the model a response is expected\n",
    ").to(model.device)\n",
    "\n",
    "with torch.no_grad():            # saves memory — no gradients needed for inference\n",
    "    output = model.generate(\n",
    "        input_ids,\n",
    "        max_new_tokens=200,\n",
    "        do_sample=True,\n",
    "        temperature=0.7,\n",
    "        repetition_penalty=1.1   # reduces repetitive output, common with small models\n",
    "    )\n",
    "\n",
    "# decode only the new tokens (strip the prompt from the output)\n",
    "response = tokenizer.decode(\n",
    "    output[0][input_ids.shape[-1]:],   # ← slices off the input, shows only the reply\n",
    "    skip_special_tokens=True\n",
    ")\n",
    "\n",
    "print(\"── Response ──────────────────────────────\")\n",
    "print(response)"
   ]
  },
